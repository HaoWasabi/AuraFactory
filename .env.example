# ============================================================
# AuraFactory — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# === Discord Bot ===
DISCORD_TOKEN="your-bot-token-here"
GUILD_ID="your-guild-id"

# === Discord OAuth2 (for Web Dashboard) ===
DISCORD_CLIENT_ID="your-client-id"
DISCORD_CLIENT_SECRET="your-client-secret"
DISCORD_REDIRECT_URI="http://localhost:8000/auth/callback"

# === LLM Provider ===
# Options: gemini | groq | openrouter | ollama
LLM_PROVIDER="gemini"
GEMINI_TOKEN="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# === Server ===
HOST="0.0.0.0"
PORT=8000
DEBUG=true
SECRET_KEY="change-this-to-a-random-string-in-production"

# === Database (optional — runs without persistence if not set) ===
# DATABASE_URL="postgresql://localhost:5432/aurafactory"
