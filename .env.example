# ============================
# AuraFactory Environment Variables
# ============================
# Copy this file to .env and fill in your values

# --- Discord Bot ---
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=https://your-app.onrender.com/auth/callback
ALLOWED_GUILD_IDS=123456789012345678

# --- LLM Provider ---
# Options: gemini | bedrock
# Set to "bedrock" to use AWS Bedrock (Amazon Nova models)
LLM_PROVIDER=gemini

# Google Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# --- AWS Bedrock (used when LLM_PROVIDER=bedrock) ---
# Region must have Amazon Nova models enabled (us-east-1 recommended)
AWS_REGION=us-east-1

# AWS credentials — for local dev only.
# On EC2 / ECS / App Runner: leave blank, use IAM role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Set to "true" to enable the Bedrock health check endpoint (optional)
ENABLE_BEDROCK_LLM=false

# Model IDs — Amazon Nova tiers:
#   amazon.nova-micro-v1:0   (fastest, cheapest  — $0.035/$0.14 per 1M tokens)
#   amazon.nova-lite-v1:0    (balanced            — $0.06/$0.24  per 1M tokens)
#   amazon.nova-pro-v1:0     (most capable        — $0.80/$3.20  per 1M tokens)
#
# Default model (Classifier, Query, ReAct)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Planner uses a smarter model for complex JSON plan generation
BEDROCK_PLANNER_MODEL=amazon.nova-pro-v1:0
# Override classifier to use the micro model (cheapest, fastest)
BEDROCK_CLASSIFIER_MODEL=amazon.nova-micro-v1:0

# --- LLM Fallback (Gemini as backup when Bedrock fails) ---
# Set to "true" to auto-switch to Gemini if Bedrock errors
LLM_FALLBACK_ENABLED=false
# Which provider to use as fallback (currently only "gemini" supported)
LLM_FALLBACK_PROVIDER=gemini
# Preferred Gemini model for fallback (gemini-2.0-flash recommended)
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# --- Database ---
DATABASE_URL=postgresql://aurafactory:password@localhost:5432/aurafactory

# --- Application ---
PORT=8000
SECRET_KEY=change-this-to-a-random-string
DEBUG=true
LOG_LEVEL=INFO
