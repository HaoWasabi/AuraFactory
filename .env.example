# ============================================================
# AuraFactory — Minimal Configuration for Demo
# Copy this to .env and fill in your values
# ============================================================

# === REQUIRED (only these 2 to run) ===
DISCORD_TOKEN=your_discord_bot_token_here
GROQ_API_KEY=your_groq_api_key_here

# === Optional: LLM Provider Selection ===
# Options: groq (default, fastest free), gemini, openrouter, ollama
LLM_PROVIDER=groq

# === Optional: Multi-Guild ===
# "all" = respond in any server the bot is added to (recommended for demo)
# Or comma-separated guild IDs: 123456789,987654321
ALLOWED_GUILD_IDS=all

# === Optional: Other LLM Providers ===
# GEMINI_API_KEY=your_gemini_key
# OPENROUTER_API_KEY=your_openrouter_key
# OLLAMA_BASE_URL=http://localhost:11434

# === Optional: Database (not required for demo) ===
# DATABASE_URL=[REDACTED_CONN_STRING]
# POSTGRES_PASSWORD=[REDACTED_PASSWORD]

# === Optional: Observability ===
# LOG_LEVEL=INFO
# TRACE_ENABLED=true
# DEBUG=true
