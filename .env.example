# AuraFactory — Environment Variables
# Copy to .env and fill in your values
# ============================================

# Discord Bot
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=https://your-domain.com/api/auth/callback

# Guild access control
# "open" = any server, "whitelist" = only ALLOWED_GUILD_IDS
GUILD_LOCK_MODE=whitelist
ALLOWED_GUILD_IDS=123456789,987654321

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Database (PostgreSQL)
DATABASE_URL=postgresql://aurafactory:password@localhost:5432/aurafactory

# Security
SECRET_KEY=generate-a-random-32-char-string
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Server
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Token budget (daily per-guild)
DAILY_TOKEN_BUDGET=800000
PER_REQUEST_TOKEN_LIMIT=10000

# Rate limiting
RATE_LIMIT_DELAY=0.5
