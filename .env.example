# ============================
# AuraFactory Environment Variables
# ============================
# Copy this file to .env and fill in your values

# --- Discord Bot ---
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=https://your-app.onrender.com/auth/callback
ALLOWED_GUILD_IDS=123456789012345678

# --- LLM Provider ---
# Options: gemini | groq | openrouter | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Groq (alternative)
# GROQ_API_KEY=your_groq_api_key

# OpenRouter (alternative)
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=google/gemini-flash-1.5

# Ollama (local dev only)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# --- Database ---
DATABASE_URL=postgresql://aurafactory:password@localhost:5432/aurafactory

# --- Application ---
PORT=8000
SECRET_KEY=change-this-to-a-random-string
DEBUG=true
LOG_LEVEL=INFO

# --- AWS (Phase 2 — not used yet) ---
# ENABLE_BEDROCK_LLM=false
# ENABLE_BEDROCK_GUARDRAILS=false
# ENABLE_TITAN_EMBEDDING=false
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
