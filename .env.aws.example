# =============================================================
# AuraFactory — Phase 2 AWS Environment Variables
# =============================================================
# Copy this to .env and fill in your values:
#   cp .env.aws.example .env
# =============================================================

# === LLM Provider (Amazon Bedrock) ===
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AWS_REGION=us-east-1

# === AWS Credentials (for local dev only — App Runner uses IAM Role) ===
AWS_ACCESS_KEY_ID=AKIA_YOUR_KEY_HERE
AWS_SECRET_ACCESS_KEY=your_secret_here

# === Database (DynamoDB) ===
DATABASE_BACKEND=dynamodb
DYNAMODB_TABLE_NAME=aurafactory

# === Bedrock Guardrails (optional — create in AWS Console first) ===
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# === Discord Configuration ===
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback

# === Security ===
SECRET_KEY=generate-a-random-string-here
GUILD_LOCK_MODE=open
ALLOWED_GUILD_IDS=

# === App Config ===
PORT=8000
DEBUG=true
LOG_LEVEL=INFO
MAX_MESSAGE_LENGTH=2000
DAILY_TOKEN_BUDGET=800000
PER_REQUEST_TOKEN_LIMIT=10000
